# Base de datos — Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct/unpooled connection, used by Drizzle Kit for migrations.
DATABASE_URL_SINPOOLING="postgresql://user:password@host/dbname?sslmode=require"

# Autenticación — Better Auth
BETTER_AUTH_SECRET="your-secret-here-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="gloria-y-fuego"
R2_PUBLIC_URL="https://your-r2-public-url"

# Formularios (Fase 1 MVP)
FORMSPREE_ENDPOINT="https://formspree.io/f/your-form-id"

# Biblia digital (API.Bible). Mantener la clave únicamente en el servidor.
# La RVR1960 requiere estar habilitada para la aplicación y mostrar su atribución/licencia.
API_BIBLE_API_KEY=""
API_BIBLE_BIBLE_ID=""

# Destino de WhatsApp para peticiones. En local usa tu número de prueba;
# en Vercel reemplázalo por el número de Profeta Silvia (solo dígitos, con código de país).
WHATSAPP_PRAYER_RECIPIENT=""

# App
# En local: http://localhost:3000. En producción, reemplazar por el dominio confirmado.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Ministerio Gloria y Fuego"
